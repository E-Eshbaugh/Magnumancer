  maps:
  - scene: Oldwoods3D
    displayName: The Oldwoods
    flavor: The last Lost Grove. The Verdant Circle buried its traps under every root.
    miniature: {fileID: 1515265693261919113, guid: 5bde5b26cd18f48dbbd16d6acb1480b1, type: 3}
    tablePos: {x: -1.05, y: -1.35}
    height: 0.05
    glow: {r: 0.45, g: 1, b: 0.45, a: 1}
  - scene: Stormspire
    displayName: Stormspire
    flavor: Storm-wracked peaks where the Voltborn learned to strike and vanish.
    miniature: {fileID: 1864879113965382174, guid: c9233666f472b4e08bcb11c8406a2de4, type: 3}
    tablePos: {x: -1.05, y: 1.35}
    height: 0.55
    glow: {r: 1, g: 0.92, b: 0.35, a: 1}
  - scene: FungalHollow
    displayName: Fungal Hollow
    flavor: A grove gone to spore. The Blightward still tend what grows here.
    miniature: {fileID: 1778677783997697841, guid: d3574a7dfe8a24bc0b5bb89a0cafb911, type: 3}
    tablePos: {x: -3.15, y: -1.35}
    height: 0.1
    glow: {r: 0.75, g: 1, b: 0.3, a: 1}
  - scene: Riftforge
    displayName: Riftforge
    flavor: A canyon fortress on the lip of a Dark Rift. Granite Vow ground.
    miniature: {fileID: 1737369127483119573, guid: 553f208f757074a2e99733d8f2766174, type: 3}
    tablePos: {x: 1.05, y: 1.35}
    height: 0.45
    glow: {r: 1, g: 0.6, b: 0.3, a: 1}
  - scene: CinderCrucibleZombies
    displayName: Cinder Crucible
    flavor: The Emberguard's volcanic forge. Goblins crawl up from its depths.
    miniature: {fileID: 8608501547111897109, guid: cb6a56730637d4dafa6f37602efbd6f1, type: 3}
    tablePos: {x: 3.15, y: 1.35}
    height: 0.5
    glow: {r: 1, g: 0.4, b: 0.15, a: 1}
  - scene: DrownedSanctum
    displayName: Drowned Sanctum
    flavor: Flooded ruins of the old healing springs, held by the Tidebound.
    miniature: {fileID: 4259601750230487447, guid: 649a26d78650049029e3b894a9680cc5, type: 3}
    tablePos: {x: 1.05, y: -1.35}
    height: 0
    glow: {r: 0.3, g: 0.7, b: 1, a: 1}
  - scene: BlackOsuary
    displayName: Black Ossuary
    flavor: Cursed tunnels where the Hollow chase the magic nobody should.
    miniature: {fileID: 5150072979807848576, guid: 4f215af1f62344967b535b62ba1bd9bd, type: 3}
    tablePos: {x: 3.15, y: -1.35}
    height: 0.1
    glow: {r: 0.7, g: 0.35, b: 1, a: 1}
  - scene: Frostgrave
    displayName: Frostgrave
    flavor: A shattered glacier sanctuary. The Frostwardens never miss twice.
    miniature: {fileID: 243345584303030140, guid: ea8d20cf8cdc74d01a6ae2f6daf02cde, type: 3}
    tablePos: {x: -3.15, y: 1.35}
    height: 0.6
    glow: {r: 0.6, g: 0.9, b: 1, a: 1}
  modes:
  - name: Deathmatch
    description: Every magus for themselves. Last soul standing drinks the fading light.
  - name: Team Deathmatch
    description: Two pacts, two sworn foes. Hold formation and reap their lives in tandem.
  - name: Waves
    description: Goblin tides claw up from a Dark Rift. Hold the line together until it stills.
